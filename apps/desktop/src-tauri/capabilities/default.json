{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Bureau's window may call. Kept minimal; each plugin is added with the phase that needs it. No shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "window-state:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
