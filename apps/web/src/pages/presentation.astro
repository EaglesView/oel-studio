---
import Base from '../layouts/Base.astro';
import { features } from '../edition';
import { PresentationPage } from '../document/PresentationPage';
// Share-link landing: single-user builds have no share links (plan solo MVP, S-5).
if (!features.collab) return Astro.redirect('/bureau');
---
<Base title="Présentation · OutilsEnLigne" description="Présentations compatibles PowerPoint : diapositives, notes, diaporama, .pptx." app>
  <!-- Yjs, IndexedDB and the engine worker: client only. The share token stays in the URL fragment. -->
  <PresentationPage client:only="react" />
  <noscript><p class="page">L’éditeur de présentations a besoin de JavaScript.</p></noscript>
</Base>
