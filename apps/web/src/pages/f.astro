---
import Base from '../layouts/Base.astro';
import { features } from '../edition';
import { FormPage } from '../forms/FormPage';
// Forms (and their sign-in links) ship with the team edition (plan solo MVP, S-6).
if (!features.forms) return Astro.redirect('/');
---
<Base title="Formulaire · OutilsEnLigne" description="Répondre à un formulaire OutilsEnLigne : pas de compte, brouillon gardé sur l’appareil.">
  <!-- Drafts live in localStorage and the backend is client-side for now: client only. -->
  <FormPage client:only="react" />
  <noscript><p class="page">Ce formulaire a besoin de JavaScript.</p></noscript>
</Base>
