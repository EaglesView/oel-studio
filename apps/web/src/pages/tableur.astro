---
import Base from '../layouts/Base.astro';
import { TableurPage } from '../document/TableurPage';
---
<Base title="Tableur · OutilsEnLigne" description="Tableur collaboratif compatible Excel : formules, mise en forme, .xlsx et .csv." app>
  <!-- Yjs, IndexedDB, the calc worker and the engine worker: client only. The share token stays in the URL fragment. -->
  <TableurPage client:only="react" />
  <noscript><p class="page">Le tableur a besoin de JavaScript.</p></noscript>
</Base>
