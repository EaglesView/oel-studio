---
import '@fontsource-variable/montserrat';
import '@oel/emboss/styles.css';
import '../styles/app.css';

interface Props {
  title: string;
  description?: string;
  /** Full-viewport app pages lock body scroll. */
  app?: boolean;
  /**
   * Page language. Site pages pass theirs (French at /, English under /en); without it the page is
   * the Bureau's and follows the person's choice (`oel-lang` cookie, `src/lang.ts`), French by default.
   */
  lang?: 'fr-CA' | 'en';
}
const { title, description = 'Un seul éditeur pour tous vos fichiers, directement dans le navigateur.', app = false, lang } = Astro.props;
---
<!doctype html>
<html lang={lang ?? 'fr-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
    {!lang && (
      <script is:inline>
        // The Bureau's language before any module runs (src/lang.ts): `?lang=` from the site's
        // « Ouvrir le Bureau » wins and is remembered, then the `oel-lang` cookie, then localStorage
        // (the desktop app's webview keeps no cookies), then French.
        try {
          const url = new URL(location.href);
          const asked = url.searchParams.get('lang');
          let l = (document.cookie.match(/(?:^|;\s*)oel-lang=(fr|en)\b/) || [])[1] || localStorage.getItem('oel-lang');
          if (asked === 'fr' || asked === 'en') {
            l = asked;
            document.cookie = 'oel-lang=' + asked + '; Max-Age=31536000; Path=/; SameSite=Lax';
            localStorage.setItem('oel-lang', asked);
            document.documentElement.dataset.langFrom = 'site';
            url.searchParams.delete('lang');
            history.replaceState(history.state, '', url);
          }
          if (l === 'en') document.documentElement.lang = 'en-CA';
        } catch {}
      </script>
    )}
    <script is:inline>
      // Apply the saved theme before first paint (no flash).
      try {
        const t = localStorage.getItem('oel-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // The desktop app draws its own 40 px title bar (src/desktop): keep the room before first paint.
      if (window.isTauri) document.documentElement.style.setProperty('--emboss-inset-top', '40px');
    </script>
    <script>
      // Visit counting, only in builds with PUBLIC_POSTHOG_KEY (src/analytics.ts).
      import '../analytics';
    </script>
  </head>
  <body class={app ? 'is-app' : undefined}>
    <a class="skip-link" href="#contenu">
      {lang ? (lang === 'en' ? 'Skip to content' : 'Aller au contenu') : <><span data-lang="fr">Aller au contenu</span><span data-lang="en">Skip to content</span></>}
    </a>
    <slot />
  </body>
</html>
