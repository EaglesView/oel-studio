{
  "name": "@oel/sheets",
  "version": "0.1.0",
  "description": "Excel-compatible spreadsheet editor: canvas grid, IronCalc engine (oelxlsx-rs WASM) in a worker, Yjs collaboration with id-based references, lossless .xlsx and .csv round trips.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./model": "./src/model/index.ts",
    "./calc-worker": "./src/calc/calc.worker.ts",
    "./styles.css": "./src/ui/sheets.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@oel/collab-client": "*",
    "@oel/emboss": "*",
    "oelxlsx-rs": "file:../../../oelxlsx_rs/pkg",
    "react-aria-components": "^1.21.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "oelxlsx-node": "file:../../../oelxlsx_rs/pkg-node"
  }
}
