    "@oel/i18n": "*",
    "react-aria-components": "^1.21.1"
  },
  "devDependencies": {
    "oelxlsx-node": "file:../wasm/oel-xlsx/node",
    "oelpptx-node": "file:../wasm/oel-pptx/node",
    "oeldocx-node": "file:../wasm/oel-docx/node",
    "@types/react": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
