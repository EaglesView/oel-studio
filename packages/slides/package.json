    "@oel/charts": "*",
    "@oel/links": "*",
    "@oel/img": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "oelpptx-node": "file:../wasm/oel-pptx/node"
