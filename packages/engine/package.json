    "./generated/oelpptx": "./src/generated/oelpptx/index.ts"
  },
  "dependencies": {
    "oeldocx-rs": "file:../wasm/oel-docx/web",
    "oelxlsx-rs": "file:../wasm/oel-xlsx/web",
    "oelpptx-rs": "file:../wasm/oel-pptx/web"
  },
  "devDependencies": {
    "oeldocx-node": "file:../wasm/oel-docx/node",
    "oelpptx-node": "file:../wasm/oel-pptx/node"
